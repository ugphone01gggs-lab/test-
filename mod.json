{
	"geode": "4.4.0",
	"gd": {
		"win": "2.2074",
		"android": "2.2074"
	},
	"version": "v1.4.0",
	"id": "apex.buffer",
	"name": "ApexBuffer",
	"developer": "Apex",
	"description": "Smart adaptive input buffer. Delays early clicks to improve survival. Works on PC and Android.",
	"tags": ["gameplay", "utility", "offline"],
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Enable ApexBuffer",
			"description": "Master switch",
			"default": true
		},
		"practice-only": {
			"type": "bool",
			"name": "Practice Mode Only",
			"description": "Only buffer in practice mode",
			"default": true
		},
		"stage": {
			"type": "int",
			"name": "Stage (Max Delay Ticks)",
			"description": "Higher = more aggressive. 4 ticks ~ 1 frame at 60fps",
			"default": 16,
			"min": 0,
			"max": 48
		},
		"wave-stage": {
			"type": "int",
			"name": "Wave Stage",
			"description": "Max delay while in wave",
			"default": 12,
			"min": 0,
			"max": 32
		},
		"aggression": {
			"type": "float",
			"name": "Aggression",
			"description": "0 = safe, 1 = aggressive",
			"default": 0.65,
			"min": 0.0,
			"max": 1.0
		},
		"auto-adapt": {
			"type": "bool",
			"name": "Auto Adapt",
			"description": "Raise stage on hard sections automatically",
			"default": true
		},
		"min-confidence": {
			"type": "float",
			"name": "Minimum Confidence",
			"description": "Do not delay if confidence is below this",
			"default": 0.55,
			"min": 0.1,
			"max": 0.95
		},
		"horizon": {
			"type": "int",
			"name": "Lookahead Horizon",
			"default": 100,
			"min": 40,
			"max": 200
		},
		"wave-horizon": {
			"type": "int",
			"name": "Wave Horizon",
			"default": 60,
			"min": 20,
			"max": 120
		},
		"orb-smart": {
			"type": "bool",
			"name": "Smart Orb",
			"description": "Consider orb click vs skip",
			"default": true
		},
		"show-status": {
			"type": "bool",
			"name": "Show Status Text",
			"default": true
		}
	}
}
